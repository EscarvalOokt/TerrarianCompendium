<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <RootNamespace>TerrarianCompendium.Tests</RootNamespace>
        <AssemblyName>TerrarianCompendium.Tests</AssemblyName>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <Import Project="..\..\src\TerrarianCompendium.Local.props"
            Condition="Exists('..\..\src\TerrarianCompendium.Local.props')"/>

    <PropertyGroup>
        <TerrariaModderCoreDll Condition="'$(TerrariaDirectory)' != ''">$(TerrariaDirectory)\TerrariaModder\core\TerrariaModder.Core.dll</TerrariaModderCoreDll>
    </PropertyGroup>

    <Target Name="ValidateLocalConfiguration"
            BeforeTargets="ResolveReferences">
        <Error Condition="'$(TerrariaDirectory)' == ''"
               Text="TerrariaDirectory is not configured. Create src\TerrarianCompendium.Local.props from docs\TerrarianCompendium.Local.props.example and set the Terraria installation path."/>
        <Error Condition="'$(TerrariaModderCoreDll)' != '' and !Exists('$(TerrariaModderCoreDll)')"
               Text="TerrariaModder.Core.dll was not found at '$(TerrariaModderCoreDll)'. Update TerrariaDirectory in src\TerrarianCompendium.Local.props."/>
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"
                          Version="18.8.1"/>
        <PackageReference Include="NUnit"
                          Version="4.6.1"/>
        <PackageReference Include="NUnit3TestAdapter"
                          Version="6.2.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\TerrarianCompendium\TerrarianCompendium.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TerrariaModderCoreDll)' != ''">
        <Reference Include="TerrariaModder.Core">
            <HintPath>$(TerrariaModderCoreDll)</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\mod\manifest.json"
              Link="Project\manifest.json"
              CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Project\"/>
    </ItemGroup>
</Project>